                },
                {
                  "key": "in",
                  "value": "query"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"<string>\",\n  \"shape\": [\n    {\n      \"lat\": \"<double>\",\n      \"lon\": \"<double>\"\n    },\n    {\n      \"lat\": \"<double>\",\n      \"lon\": \"<double>\"\n    }\n  ],\n  \"encoded_polyline\": \"<string>\",\n  \"shape_format\": \"polyline6\",\n  \"range\": false,\n  \"height_precision\": 0,\n  \"resample_distance\": \"<integer>\"\n}",
