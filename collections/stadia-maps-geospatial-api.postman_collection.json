          "name": "Get the elevation profile along a polyline or at a point.",
          "request": {
            "name": "Get the elevation profile along a polyline or at a point.",
            "description": {
              "content": "The Stadia elevation API allows you to get the elevation of any point on earth. You can pass either a simple set of points or a Google encoded polyline string. This pairs well with our routing APIs, so you can generate an elevation profile for your next bike or run.",
              "type": "text/plain"
            },
            "url": {
