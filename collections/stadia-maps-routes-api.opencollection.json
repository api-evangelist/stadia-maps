{
  "opencollection": "1.0.0",
  "info": {
    "name": "Stadia Maps Routes API",
    "version": "7.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Routes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Calculate an optimized route between a known start and end point.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.stadiamaps.com/optimized_route/v1",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "query"
            }
          },
          "docs": "The optimized route API is a mix of the matrix and normal route API. For an optimized route, the start and end point are fixed, but the intermediate points will be re-ordered to form an optimal route visiting all nodes once."
        }
      ]
    }
  ],
  "bundled": true
}