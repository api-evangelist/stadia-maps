                        {
                          "key": "value",
                          "value": "{{apiKey}}",
                          "type": "string"
                        },
                        {
                          "key": "in",
                          "value": "query",
                          "type": "string"
                        }
                      ]
                    },
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/geocoding/v1/place?ids=<string>,<string>&lang=<string>",
